# 複製本檔為 .env 並填入實際值。.env 已列入 .gitignore，不會進入版本控制。

# --- 資料庫 ------------------------------------------------------------------
DB_USER=postgres
DB_HOST=localhost
DB_NAME=ERP_db
DB_PASSWORD=請填入實際密碼
DB_PORT=5432

# --- API 伺服器 --------------------------------------------------------------
HTTPS_PORT=5566

# SSL 憑證路徑（未設定時使用專案內的 ssl/ 目錄）
# SSL_KEY_PATH=/etc/ssl/private/server.key
# SSL_CERT_PATH=/etc/ssl/certs/server.crt
# SSL_CA_PATH=/etc/ssl/certs/ca.crt

# --- 允許的前端來源（CORS）---------------------------------------------------
# 未設定時只允許同源與本機。同源存取與 Vite Proxy 不受此限制影響，
# 只有「瀏覽器從其他網域直接呼叫本 API」的情況才需要設定。
# 多個來源以逗號分隔，需含通訊協定與連接埠。
# ALLOWED_ORIGINS=https://erp.metech.local,https://192.168.100.249
